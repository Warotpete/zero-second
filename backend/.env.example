# Copy to backend/.env (never commit it). Without these, Zero Second runs with the local writer.
# Microsoft Foundry project endpoint, e.g. https://<your-resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name in that project, e.g. gpt-4.1-mini
FOUNDRY_MODEL=
# auto (default: Foundry if configured) | local | foundry
ZS_LLM=auto
# Seconds before an agent call times out and the deterministic fallback is used
ZS_AGENT_TIMEOUT=40
